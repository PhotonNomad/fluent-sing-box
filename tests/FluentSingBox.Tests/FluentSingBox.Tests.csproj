<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FluentSingBox.Configuration/FluentSingBox.Configuration.csproj" />
    <ProjectReference Include="../../src/FluentSingBox.Updates/FluentSingBox.Updates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the portable client logic without loading WinUI or starting the core. -->
    <Compile Include="../../src/FluentSingBox.Client/Models/ObservableModel.cs" Link="Client/ObservableModel.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Models/ProxyModels.cs" Link="Client/ProxyModels.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Models/ConfigurationOptions.cs" Link="Client/ConfigurationOptions.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/Localization.cs" Link="Client/Localization.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ServerLinkImporter.cs" Link="Client/ServerLinkImporter.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ServerMetadataComparer.cs" Link="Client/ServerMetadataComparer.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/SettingsCheckpoint.cs" Link="Client/SettingsCheckpoint.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ServerCatalog.cs" Link="Client/ServerCatalog.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ServerTags.cs" Link="Client/ServerTags.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ConfigFileWatcher.cs" Link="Client/ConfigFileWatcher.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ConfigFileRevisions.cs" Link="Client/ConfigFileRevisions.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/SettingsStore.cs" Link="Client/SettingsStore.cs" />
    <EmbeddedResource Include="../../src/FluentSingBox.Client/Resources/Strings.resx" Link="Client/Strings.resx" LogicalName="FluentSingBox.Client.Resources.Strings.resources" />
  </ItemGroup>
</Project>
