<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FluentSingBox.Configuration/FluentSingBox.Configuration.csproj" />
    <ProjectReference Include="../../src/FluentSingBox.Updates/FluentSingBox.Updates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the portable client logic without loading WinUI or starting the core. -->
    <Compile Include="../../src/FluentSingBox.Client/Models/AppSettings.cs" Link="Client/AppSettings.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/Localization.cs" Link="Client/Localization.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ProfileMessages.cs" Link="Client/ProfileMessages.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/DomainResolverText.cs" Link="Client/DomainResolverText.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ApplicationMatching.cs" Link="Client/ApplicationMatching.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ServerLinkImporter.cs" Link="Client/ServerLinkImporter.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ConfigFileWatcher.cs" Link="Client/ConfigFileWatcher.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/ConfigFileRevisions.cs" Link="Client/ConfigFileRevisions.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/SettingsStore.cs" Link="Client/SettingsStore.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/SubscriptionService.cs" Link="Client/SubscriptionService.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/NodeProbeService.cs" Link="Client/NodeProbeService.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/AppPaths.cs" Link="Client/AppPaths.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/DiagnosticsLog.cs" Link="Client/DiagnosticsLog.cs" />
    <Compile Include="../../src/FluentSingBox.Client/Services/DnsCachePolicy.cs" Link="Client/DnsCachePolicy.cs" />
    <EmbeddedResource Include="../../src/FluentSingBox.Client/Resources/Strings.resx" Link="Client/Strings.resx" LogicalName="FluentSingBox.Client.Resources.Strings.resources" />
  </ItemGroup>
</Project>
