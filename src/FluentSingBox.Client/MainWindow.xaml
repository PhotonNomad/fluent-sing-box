<Window
    x:Class="FluentSingBox.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="fluent sing-box">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="4,0,0,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftPaddingColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="NavigationPaneToggleButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Margin="0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="NavigationPaneToggleButton_Click"
                Visibility="Collapsed"
                AutomationProperties.Name="显示导航菜单">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE700;" FontSize="16" />
            </Button>
            <Image
                x:Name="BrandIconImage"
                Grid.Column="2"
                Width="16"
                Height="16"
                Margin="12,0,0,0"
                Stretch="Uniform"
                VerticalAlignment="Center"
                AutomationProperties.Name="fluent sing-box 图标" />
            <TextBlock
                Grid.Column="3"
                Margin="16,0,0,0"
                Text="fluent sing-box"
                Style="{StaticResource CaptionTextBlockStyle}"
                VerticalAlignment="Center" />
            <Grid x:Name="TitleBarDragRegion" Grid.Column="4" Background="Transparent" />
        </Grid>
        <InfoBar x:Name="RecoveryMessage" Grid.Row="1" IsOpen="False" Severity="Error" IsClosable="True" AutomationProperties.AutomationId="App_RecoveryStatus" />
        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftMinimal"
            IsTitleBarAutoPaddingEnabled="False"
            DisplayModeChanged="RootNavigationView_DisplayModeChanged"
            SelectionChanged="RootNavigationView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="服务器" Tag="servers" AutomationProperties.AutomationId="Navigation_Servers">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="路由" Tag="routing" AutomationProperties.AutomationId="Navigation_Routing">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Map" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="代理" Tag="proxy" AutomationProperties.AutomationId="Navigation_Proxy">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs" AutomationProperties.AutomationId="Navigation_Logs">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Frame x:Name="ContentFrame" />
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
