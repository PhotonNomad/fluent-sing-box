<Window x:Class="FluentSingBox.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="fluent sing-box">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="4,0,0,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftPaddingColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Button x:Name="NavigationPaneToggleButton" Grid.Column="1" Width="40" Height="40" Margin="0" Padding="0" Background="Transparent" BorderThickness="0" Click="NavigationPaneToggleButton_Click" Visibility="Collapsed" x:Uid="MainWindow_NavigationPaneToggleButton">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="" FontSize="16" />
            </Button>
            <Image x:Name="BrandIconImage" Grid.Column="2" Width="20" Height="20" Margin="12,0,0,0" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.AutomationId="App_BrandIcon" x:Uid="MainWindow_BrandIconImage" />
            <TextBlock Grid.Column="3" Margin="16,0,0,0" Text="fluent sing-box" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <Grid x:Name="TitleBarDragRegion" Grid.Column="4" Background="Transparent" />
        </Grid>
        <StackPanel Grid.Row="1">
            <InfoBar x:Name="RecoveryMessage" IsOpen="False" Severity="Error" IsClosable="True" AutomationProperties.AutomationId="App_RecoveryStatus" />
            <InfoBar x:Name="AvailableUpdate" IsOpen="False" Severity="Informational" IsClosable="True" AutomationProperties.AutomationId="Updates_Notification">
                <InfoBar.ActionButton><Button x:Uid="Updates_OpenSettings" Click="OpenUpdateSettings_Click" /></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <NavigationView x:Name="RootNavigationView" Grid.Row="2" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" PaneDisplayMode="LeftMinimal" IsTitleBarAutoPaddingEnabled="False" DisplayModeChanged="RootNavigationView_DisplayModeChanged" SelectionChanged="RootNavigationView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="servers" AutomationProperties.AutomationId="Navigation_Servers" x:Uid="MainWindow_NavigationViewItem28">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="proxy" AutomationProperties.AutomationId="Navigation_Proxy" x:Uid="MainWindow_NavigationViewItem34">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="routing" AutomationProperties.AutomationId="Navigation_Routing" x:Uid="MainWindow_NavigationViewItem31">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Map" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="DNS" Tag="dns" AutomationProperties.AutomationId="Navigation_DNS">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Globe" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="logs" AutomationProperties.AutomationId="Navigation_Logs" x:Uid="MainWindow_NavigationViewItem37">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavigationItem" Tag="settings" AutomationProperties.AutomationId="Navigation_Settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Button x:Name="CoreSwitch" Margin="12,8" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.AutomationId="Core_Toggle" Click="CoreSwitch_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="CoreActionIcon" FontSize="14" />
                        <TextBlock x:Name="CoreActionText" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>
            <NavigationView.Content>
                <Frame x:Name="ContentFrame" />
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
