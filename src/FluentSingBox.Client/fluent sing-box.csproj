<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FluentSingBox.Client</RootNamespace>
    <AssemblyName>fluent sing-box</AssemblyName>
    <Product>fluent sing-box</Product>
    <Title>fluent sing-box</Title>
    <PackageId>fluent-sing-box</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Assets\fluent-sing-box.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\publish\$(Configuration)\</PublishDir>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FluentSingBox.Updates/FluentSingBox.Updates.csproj" />
    <None Include="../../release.json" Link="release.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
    <!-- SettingsControls references the old aggregate SDK; use only the component assets above. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" ExcludeAssets="all" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PRIResource Include="Strings\**\*.resw" />
    <None Update="Defaults\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Defaults\user-config.json" LogicalName="FluentSingBox.Client.Resources.default-user-config.json" />
    <None Update="ThirdParty\Schemas\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\fluent-sing-box.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\fluent-sing-box.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty\RuleSets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="ThirdParty\SingBox\sing-box-1.14.2-windows-amd64.zip" />
    <EmbeddedResource Include="ThirdParty\SingBox\sing-box-1.14.2-windows-amd64.zip">
      <LogicalName>FluentSingBox.Client.Resources.sing-box-1.14.2-windows-amd64.zip</LogicalName>
    </EmbeddedResource>
    <None Update="ThirdParty\SingBox\sing-box-1.14.2-source.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty\SingBox\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty\SingBox\GPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty\SingBox\NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <CompiledXamlForPublish Include="$(TargetDir)**\*.xbf;$(TargetDir)*.pri" />
      <AppIconsForPublish Include="$(MSBuildProjectDirectory)\Assets\fluent-sing-box.png;$(MSBuildProjectDirectory)\Assets\fluent-sing-box.ico" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledXamlForPublish)" DestinationFiles="@(CompiledXamlForPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AppIconsForPublish)" DestinationFolder="$(PublishDir)Assets\" SkipUnchangedFiles="true" />
  </Target>
</Project>
