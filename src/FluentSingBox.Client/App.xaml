<Application
    x:Class="FluentSingBox.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:FluentSingBox.Client.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <x:Double x:Key="PageMaxWidth">1000</x:Double>
            <x:Double x:Key="PageHeaderMaxWidth">1020</x:Double>
            <x:Double x:Key="SettingActionControlMinWidth">240</x:Double>
            <x:Double x:Key="SettingsCardSpacing">2</x:Double>

            <Style TargetType="ListViewItem">
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
