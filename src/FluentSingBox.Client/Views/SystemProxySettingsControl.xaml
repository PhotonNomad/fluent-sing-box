<UserControl x:Class="FluentSingBox.Client.Views.SystemProxySettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <controls:SettingsExpander x:Name="SystemProxyCard" Header="Windows 系统代理" AutomationProperties.AutomationId="Proxy_SystemExpander">
        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE774;" /></controls:SettingsExpander.HeaderIcon>
        <controls:SettingsExpander.Items>
        <controls:SettingsCard Header="启用系统代理" Description="让遵循 Windows 代理设置的程序使用本地代理。">
            <ToggleSwitch x:Name="SystemProxySwitch" AutomationProperties.AutomationId="Proxy_SystemToggle" Toggled="SystemProxySwitch_Toggled" AutomationProperties.Name="启用系统代理" />
        </controls:SettingsCard>
                                    <controls:SettingsCard Header="协议" Description="HTTP / SOCKS5 共用本地端口；Windows 系统代理使用 HTTP。" />
                                    <controls:SettingsCard Header="监听地址" Description="127.0.0.1 · 仅允许本机连接。" />
                                    <controls:SettingsCard Header="监听端口" Description="填写本地代理端口。">
                                        <TextBox x:Name="PortTextBox" AutomationProperties.AutomationId="Proxy_PortTextBox" MinWidth="{StaticResource SettingActionControlMinWidth}" PlaceholderText="10809" InputScope="Number" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard Header="身份验证" Description="为本地代理配置用户名和密码。">
                                        <ToggleSwitch x:Name="AuthenticationSwitch" AutomationProperties.AutomationId="Proxy_AuthenticationSwitch" Toggled="AuthenticationSwitch_Toggled" AutomationProperties.Name="启用系统代理身份验证" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard x:Name="UsernameCard" Header="用户名" Description="" Visibility="Collapsed">
                                        <TextBox x:Name="UsernameTextBox" AutomationProperties.AutomationId="Proxy_UsernameTextBox" MinWidth="{StaticResource SettingActionControlMinWidth}" PlaceholderText="用户名" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard x:Name="PasswordCard" Header="密码" Description="" Visibility="Collapsed">
                                        <PasswordBox x:Name="PasswordInput" AutomationProperties.AutomationId="Proxy_PasswordInput" MinWidth="{StaticResource SettingActionControlMinWidth}" PlaceholderText="密码" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard Header="应用设置" Description="保存端口或身份验证更改；代理运行中会重新载入配置。">
                                        <Button AutomationProperties.AutomationId="Proxy_Apply" Content="应用设置" Click="ApplySettings_Click" Style="{StaticResource AccentButtonStyle}" />
                                    </controls:SettingsCard>
        <controls:SettingsCard Header="使用提示" Description="应用是否支持代理认证，取决于该应用自身。" />
        <controls:SettingsCard ContentAlignment="Left">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </controls:SettingsCard>
        </controls:SettingsExpander.Items>
    </controls:SettingsExpander>
</UserControl>
