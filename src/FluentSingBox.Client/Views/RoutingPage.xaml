<Page x:Class="FluentSingBox.Client.Views.RoutingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:local="using:FluentSingBox.Client.Views">
    <local:PageLayout>
        <local:PageLayout.HeaderContent>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" x:Uid="RoutingPage_TextBlock4" />
        </local:PageLayout.HeaderContent>
        <local:PageLayout.PageContent>
            <StackPanel Spacing="0">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="Routing_Description" />
                <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="Routing_Status" />

                <local:SettingsSection x:Uid="Routing_RulesSection">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="Routing_AddCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE710;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Click="AddRule_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="Routing_Add" x:Uid="Routing_Add" />
                            </controls:SettingsCard>
                            <ListView x:Name="RuleList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RuleList_ItemClick" CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="RuleList_DragItemsCompleted" Padding="0" AutomationProperties.AutomationId="Routing_Rules">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuleRow">
                                        <Grid Padding="12,10" ColumnSpacing="12" MinHeight="64" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" AutomationProperties.AutomationId="{x:Bind RowAutomationId}" AutomationProperties.Name="{x:Bind Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE76F;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Target}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                            <ToggleSwitch Grid.Column="3" IsOn="{x:Bind Enabled}" Toggled="RuleEnabled_Toggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.AutomationId="{x:Bind ToggleAutomationId}" x:Uid="Routing_Enabled" />
                                            <Button Grid.Column="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="{x:Bind MoreAutomationId}" x:Uid="Routing_More">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="EditRule_Click" x:Uid="Routing_Edit" />
                                                        <MenuFlyoutItem Click="DuplicateRule_Click" x:Uid="Routing_Duplicate" />
                                                        <MenuFlyoutItem Click="MoveUp_Click" x:Uid="Routing_MoveUp" />
                                                        <MenuFlyoutItem Click="MoveDown_Click" x:Uid="Routing_MoveDown" />
                                                        <MenuFlyoutItem Click="MoveTop_Click" x:Uid="Routing_MoveTop" />
                                                        <MenuFlyoutItem Click="MoveBottom_Click" x:Uid="Routing_MoveBottom" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteRule_Click" x:Uid="Routing_Delete" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <controls:SettingsCard x:Uid="Routing_FinalCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE909;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="FinalComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Final_SelectionChanged" AutomationProperties.AutomationId="Routing_Final" />
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Uid="RuleSets_Section">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="RuleSets_AddCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Click="AddRuleSet_Click" AutomationProperties.AutomationId="RuleSets_Add" x:Uid="RuleSets_Add" />
                            </controls:SettingsCard>
                            <ListView x:Name="RuleSetList" SelectionMode="None" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:SimpleRow">
                                        <controls:SettingsCard Header="{x:Bind Name}" Description="{x:Bind Description}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Click="EditRuleSet_Click" IsEnabled="{x:Bind CanEdit}" AutomationProperties.AutomationId="{x:Bind EditAutomationId}" x:Uid="ServersPage_Button40" />
                                                <Button Click="DeleteRuleSet_Click" AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}" x:Uid="ServersPage_Button44" />
                                            </StackPanel>
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>
            </StackPanel>
        </local:PageLayout.PageContent>
    </local:PageLayout>
</Page>
