<Page x:Class="FluentSingBox.Client.Views.ProxyPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:local="using:FluentSingBox.Client.Views">
    <local:PageLayout>
        <local:PageLayout.HeaderContent>
            <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" x:Uid="ProxyPage_TextBlock5" />
        </local:PageLayout.HeaderContent>
        <local:PageLayout.PageContent>
            <StackPanel Spacing="0">
                <local:SystemProxySettingsControl x:Name="SystemProxySettings" />

                <local:SettingsSection Header="TUN">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <InfoBar x:Name="TunStatus" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="Tun_Status" />
                            <controls:SettingsCard x:Uid="Tun_EnabledCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE839;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="TunSwitch" Toggled="TunSwitch_Toggled" AutomationProperties.AutomationId="Tun_Enabled" />
                            </controls:SettingsCard>
                            <controls:SettingsExpander x:Name="TunOptions" x:Uid="Tun_Options" AutomationProperties.AutomationId="Tun_Options">
                                <controls:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="&#xE713;" />
                                </controls:SettingsExpander.HeaderIcon>
                                <controls:SettingsExpander.Items>
                                    <controls:SettingsCard x:Uid="Tun_StackCard">
                                        <ComboBox x:Name="StackComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedValuePath="Tag" SelectionChanged="TunOption_Changed" AutomationProperties.AutomationId="Tun_Stack">
                                            <ComboBoxItem Content="mixed" Tag="Mixed" />
                                            <ComboBoxItem Content="system" Tag="System" />
                                            <ComboBoxItem Content="gvisor" Tag="Gvisor" />
                                        </ComboBox>
                                    </controls:SettingsCard>
                                    <controls:SettingsCard x:Uid="Tun_MtuCard">
                                        <TextBox x:Name="MtuTextBox" MinWidth="{StaticResource SettingActionControlMinWidth}" InputScope="Number" TextChanged="TunText_Changed" AutomationProperties.AutomationId="Tun_Mtu" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard x:Uid="Tun_StrictRouteCard">
                                        <ToggleSwitch x:Name="StrictRouteSwitch" Toggled="TunOption_Changed" AutomationProperties.AutomationId="Tun_StrictRoute" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard x:Uid="Tun_PreferRoutesCard">
                                        <ToggleSwitch x:Name="PreferRoutesSwitch" Toggled="TunOption_Changed" AutomationProperties.AutomationId="Tun_PreferRoutes" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard x:Uid="Tun_AddressesCard" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                        <TextBox x:Name="AddressesTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" TextChanged="TunText_Changed" AutomationProperties.AutomationId="Tun_Addresses" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard x:Uid="Tun_ExcludedRoutesCard" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                        <TextBox x:Name="ExcludedRoutesTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" TextChanged="TunText_Changed" AutomationProperties.AutomationId="Tun_ExcludedRoutes" x:Uid="Tun_ExcludedRoutesTextBox" />
                                    </controls:SettingsCard>
                                </controls:SettingsExpander.Items>
                            </controls:SettingsExpander>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>
            </StackPanel>
        </local:PageLayout.PageContent>
    </local:PageLayout>
</Page>
