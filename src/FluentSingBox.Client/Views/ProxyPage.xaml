<Page x:Class="FluentSingBox.Client.Views.ProxyPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:FluentSingBox.Client.Models" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:local="using:FluentSingBox.Client.Views">
    <Grid>
        <local:PageLayout x:Name="OverviewPanel">
            <local:PageLayout.HeaderContent>
                <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" x:Uid="ProxyPage_TextBlock5" />
            </local:PageLayout.HeaderContent>
            <local:PageLayout.PageContent>
                <StackPanel Spacing="0">

                    <local:SystemProxySettingsControl Margin="0,32,0,0" />

                    <local:SettingsSection Header="TUN">
                        <local:SettingsSection.SectionContent>
                            <StackPanel x:Name="TunForm" Spacing="{StaticResource SettingsCardSpacing}" />
                        </local:SettingsSection.SectionContent>
                    </local:SettingsSection>
                    <local:SettingsSection x:Uid="ProxyPage_SettingsSection22">
                        <local:SettingsSection.SectionContent>
                            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                                <TextBlock x:Name="EmptyApplicationsMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="ProxyPage_EmptyApplicationsMessage" />
                                <TextBlock x:Name="ApplicationDnsHelp" TextWrapping="Wrap" />
                                <InfoBar x:Name="ApplicationWarnings" Severity="Warning" IsClosable="False" AutomationProperties.AutomationId="Application_PathWarnings" />
                                <ListView x:Name="ApplicationList" SelectionMode="None" IsItemClickEnabled="False" Padding="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ApplicationProxyProfile">
                                            <controls:SettingsExpander AutomationProperties.AutomationId="{x:Bind ExpanderAutomationId}" Header="{x:Bind Name, Mode=OneWay}" Description="{x:Bind RowDescription, Mode=OneWay}" IsExpanded="False">
                                                <controls:SettingsExpander.HeaderIcon>
                                                    <FontIcon Glyph="" />
                                                </controls:SettingsExpander.HeaderIcon>
                                                <controls:SettingsExpander.Items>
                                                    <controls:SettingsCard x:Uid="ProxyPage_SettingsCard33">
                                                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="ApplicationProxySwitch_Toggled" x:Uid="ProxyPage_ToggleSwitch34" />
                                                    </controls:SettingsCard>
                                                    <controls:SettingsCard x:Uid="ProxyPage_SettingsCard35">
                                                        <ComboBox AutomationProperties.AutomationId="{x:Bind ServerAutomationId}" ItemsSource="{x:Bind AvailableServers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{x:Bind ServerId, Mode=OneWay}" SelectionChanged="ApplicationServer_SelectionChanged" MinWidth="220" x:Uid="ProxyPage_ComboBox36" />
                                                    </controls:SettingsCard>
                                                    <controls:SettingsCard ContentAlignment="Left" x:Uid="ProxyPage_SettingsCard37">
                                                        <ItemsControl ItemsSource="{x:Bind MatchEntries, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </controls:SettingsCard>
                                                    <controls:SettingsCard x:Uid="ProxyPage_SettingsCard42">
                                                        <Button AutomationProperties.AutomationId="{x:Bind EditAutomationId}" Click="EditApplication_Click" x:Uid="ProxyPage_Button43" />
                                                    </controls:SettingsCard>
                                                    <controls:SettingsCard x:Uid="ProxyPage_SettingsCard44">
                                                        <Button AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}" Click="DeleteApplication_Click" x:Uid="ProxyPage_Button45" />
                                                    </controls:SettingsCard>
                                                </controls:SettingsExpander.Items>
                                            </controls:SettingsExpander>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <controls:SettingsCard x:Uid="ProxyPage_SettingsCard46">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <Button Click="AddApplication_Click" Style="{StaticResource AccentButtonStyle}" x:Uid="ProxyPage_Button49" />
                                </controls:SettingsCard>
                            </StackPanel>
                        </local:SettingsSection.SectionContent>
                    </local:SettingsSection>

                    <TextBlock Margin="1,32,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="ProxyPage_TextBlock50" />
                </StackPanel>
            </local:PageLayout.PageContent>
        </local:PageLayout>

    </Grid>
</Page>
