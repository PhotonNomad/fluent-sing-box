<Page x:Class="FluentSingBox.Client.Views.LogsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FluentSingBox.Client.Views">
    <Grid Padding="20,0,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" x:Uid="LogsPage_TextBlock4" />
                <TextBlock Grid.Row="1" x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="Logs_Status" x:Uid="LogsPage_StatusText" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="PauseButton" AutomationProperties.AutomationId="Logs_Pause" x:Uid="LogsPage_PauseButton" />
                    <Button Click="Clear_Click" AutomationProperties.AutomationId="Logs_Clear" x:Uid="LogsPage_Button10" />
                    <Button Click="Export_Click" AutomationProperties.AutomationId="Logs_Export" x:Uid="LogsPage_Button11" />
                </StackPanel>
                <TextBox Grid.Row="3" x:Name="FilterBox" TextChanged="Filter_Changed" AutomationProperties.AutomationId="Logs_Filter" x:Uid="LogsPage_FilterBox" />
                <TextBlock Grid.Row="4" x:Name="EmptyHint" TextWrapping="Wrap" x:Uid="LogsPage_EmptyHint" />
                <TextBox Grid.Row="5" x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.AutomationId="Logs_Content" />
                <InfoBar Grid.Row="6" x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
                <TextBlock Grid.Row="7" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="LogsPage_TextBlock16" />
    </Grid>
</Page>
