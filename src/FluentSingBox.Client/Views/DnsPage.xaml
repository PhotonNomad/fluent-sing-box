<Page x:Class="FluentSingBox.Client.Views.DnsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:local="using:FluentSingBox.Client.Views">
    <local:PageLayout>
        <local:PageLayout.HeaderContent>
            <TextBlock Text="DNS" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
        </local:PageLayout.HeaderContent>
        <local:PageLayout.PageContent>
            <StackPanel Spacing="0">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="Dns_Description" />
                <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="Dns_Status" />

                <local:SettingsSection x:Uid="Dns_GeneralSection">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="Dns_FinalCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE909;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="FinalComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="General_Changed" AutomationProperties.AutomationId="Dns_Final" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="Dns_StrategyCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE968;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="StrategyComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedValuePath="Tag" SelectionChanged="General_Changed" AutomationProperties.AutomationId="Dns_Strategy">
                                    <ComboBoxItem Tag="Ipv4Only" x:Uid="Dns_Strategy_Ipv4Only" />
                                    <ComboBoxItem Tag="PreferIpv4" x:Uid="Dns_Strategy_PreferIpv4" />
                                    <ComboBoxItem Tag="PreferIpv6" x:Uid="Dns_Strategy_PreferIpv6" />
                                    <ComboBoxItem Tag="Ipv6Only" x:Uid="Dns_Strategy_Ipv6Only" />
                                    <ComboBoxItem Tag="AsIs" x:Uid="Dns_Strategy_AsIs" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="Dns_CacheCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE81C;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="CacheSwitch" Toggled="General_Changed" AutomationProperties.AutomationId="Dns_Cache" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="Dns_StoreDnsCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="StoreDnsSwitch" Toggled="General_Changed" AutomationProperties.AutomationId="Dns_StoreDns" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="Dns_ClearCacheCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button x:Name="ClearCacheButton" Click="ClearCache_Click" AutomationProperties.AutomationId="Dns_ClearCache" x:Uid="Dns_ClearCacheButton" />
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Uid="Dns_ServersSection">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="Dns_AddServerCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE710;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Click="AddServer_Click" AutomationProperties.AutomationId="Dns_AddServer" x:Uid="Dns_AddServer" />
                            </controls:SettingsCard>
                            <ListView x:Name="ServerList" SelectionMode="None" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:SimpleRow">
                                        <controls:SettingsCard Header="{x:Bind Name}" Description="{x:Bind Description}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Click="EditServer_Click" AutomationProperties.AutomationId="{x:Bind EditAutomationId}" x:Uid="ServersPage_Button40" />
                                                <Button Click="DeleteServer_Click" AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}" x:Uid="ServersPage_Button44" />
                                            </StackPanel>
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Uid="Dns_RulesSection">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="Dns_AddRuleCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE710;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Click="AddRule_Click" AutomationProperties.AutomationId="Dns_AddRule" x:Uid="Dns_AddRule" />
                            </controls:SettingsCard>
                            <ListView x:Name="RuleList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RuleList_ItemClick" CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="RuleList_DragItemsCompleted" Padding="0" AutomationProperties.AutomationId="Dns_Rules">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuleRow">
                                        <Grid Padding="12,10" ColumnSpacing="12" MinHeight="64" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" AutomationProperties.Name="{x:Bind Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE76F;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Target}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                            <ToggleSwitch Grid.Column="3" IsOn="{x:Bind Enabled}" Toggled="RuleEnabled_Toggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" x:Uid="Routing_Enabled" />
                                            <Button Grid.Column="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" x:Uid="Routing_More">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="EditRule_Click" x:Uid="Routing_Edit" />
                                                        <MenuFlyoutItem Click="MoveUp_Click" x:Uid="Routing_MoveUp" />
                                                        <MenuFlyoutItem Click="MoveDown_Click" x:Uid="Routing_MoveDown" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteRule_Click" x:Uid="Routing_Delete" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>
            </StackPanel>
        </local:PageLayout.PageContent>
    </local:PageLayout>
</Page>
