<Page x:Class="FluentSingBox.Client.Views.DnsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FluentSingBox.Client.Views">
    <local:PageLayout>
        <local:PageLayout.HeaderContent>
            <TextBlock Text="DNS" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
        </local:PageLayout.HeaderContent>
        <local:PageLayout.PageContent>
            <StackPanel x:Name="Form" Spacing="12" />
        </local:PageLayout.PageContent>
    </local:PageLayout>
</Page>
