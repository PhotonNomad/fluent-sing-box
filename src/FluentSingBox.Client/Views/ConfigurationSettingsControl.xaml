<UserControl x:Class="FluentSingBox.Client.Views.ConfigurationSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsExpander x:Name="ProfileExpander" x:Uid="Profiles_Card" IsExpanded="False" AutomationProperties.AutomationId="Profiles_Details">
            <controls:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE8F1;" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Content>
                <ComboBox x:Name="ProfileComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Profile_SelectionChanged" AutomationProperties.AutomationId="Profiles_Active" x:Uid="Profiles_Active" />
            </controls:SettingsExpander.Content>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard x:Uid="Profiles_ManageCard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="New_Click" AutomationProperties.AutomationId="Profiles_New" x:Uid="Profiles_New" />
                        <Button Click="Duplicate_Click" AutomationProperties.AutomationId="Profiles_Duplicate" x:Uid="Profiles_Duplicate" />
                        <Button Click="Rename_Click" AutomationProperties.AutomationId="Profiles_Rename" x:Uid="Profiles_Rename" />
                        <Button Click="Delete_Click" AutomationProperties.AutomationId="Profiles_Delete" x:Uid="Profiles_Delete" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard x:Uid="Profiles_BackupCard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Import_Click" AutomationProperties.AutomationId="Profiles_Import" x:Uid="ConfigurationCard_Import" />
                        <Button Click="Export_Click" AutomationProperties.AutomationId="Profiles_Export" x:Uid="ConfigurationCard_Export" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard x:Uid="ConfigurationCard_Location" SizeChanged="LocationCard_SizeChanged">
                    <Grid x:Name="LocationContent" ColumnSpacing="8" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LocationText" AutomationProperties.AutomationId="Configuration_FilePath" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Uid="ConfigurationCard_Edit" AutomationProperties.AutomationId="Configuration_EditJson" Click="Edit_Click" />
                        <Button Grid.Column="2" x:Uid="ConfigurationCard_OpenLocation" AutomationProperties.AutomationId="Configuration_OpenLocation" Click="OpenLocation_Click">
                            <SymbolIcon Symbol="OpenFile" />
                        </Button>
                    </Grid>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
        <InfoBar x:Name="StatusMessage" IsClosable="True" AutomationProperties.AutomationId="Configuration_Status" />
    </StackPanel>
</UserControl>
