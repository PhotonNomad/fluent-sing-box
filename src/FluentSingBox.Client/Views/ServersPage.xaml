<Page x:Class="FluentSingBox.Client.Views.ServersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:local="using:FluentSingBox.Client.Views">
    <local:PageLayout>
        <local:PageLayout.HeaderContent>
            <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" x:Uid="ServersPage_TextBlock4" />
        </local:PageLayout.HeaderContent>
        <local:PageLayout.PageContent>
            <StackPanel Spacing="0">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="ServersPage_TextBlock7" />
                <InfoBar x:Name="OperationMessage" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="Servers_Status" />

                <local:SettingsSection x:Uid="ServersPage_SettingsSection18">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="Servers_DefaultCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE734;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="DefaultServerComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="DefaultServer_SelectionChanged" AutomationProperties.AutomationId="Servers_DefaultServer" x:Uid="Servers_DefaultServer" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="ServersPage_SettingsCard12">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE710;" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="ImportServer_Click" AutomationProperties.AutomationId="Servers_Import" x:Uid="ServersPage_Button16" />
                                    <Button AutomationProperties.AutomationId="Servers_Add" Click="AddServer_Click" Style="{StaticResource AccentButtonStyle}" x:Uid="ServersPage_Button17" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <TextBlock x:Name="EmptyMessage" Margin="1,8,0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="ServersPage_EmptyMessage" />
                            <ListView x:Name="ServerList" SelectionMode="None" IsItemClickEnabled="False" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:NodeRow">
                                        <controls:SettingsExpander Header="{x:Bind Name}" Description="{x:Bind Description}" IsExpanded="False" AutomationProperties.AutomationId="{x:Bind ExpanderAutomationId}">
                                            <controls:SettingsExpander.HeaderIcon>
                                                <FontIcon Glyph="&#xE968;" />
                                            </controls:SettingsExpander.HeaderIcon>
                                            <controls:SettingsExpander.Items>
                                                <controls:SettingsCard x:Uid="ServersPage_SettingsCard35">
                                                    <Button Click="SetDefault_Click" AutomationProperties.AutomationId="{x:Bind DefaultAutomationId}" x:Uid="ServersPage_Button36" />
                                                </controls:SettingsCard>
                                                <controls:SettingsCard x:Uid="ServersPage_SettingsCard37">
                                                    <Button Click="ProbeServer_Click" AutomationProperties.AutomationId="{x:Bind ProbeAutomationId}" x:Uid="ServersPage_Button38" />
                                                </controls:SettingsCard>
                                                <controls:SettingsCard x:Uid="Servers_ManageCard">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Click="EditServer_Click" AutomationProperties.AutomationId="{x:Bind EditAutomationId}" x:Uid="ServersPage_Button40" />
                                                        <Button Click="CopyServer_Click" AutomationProperties.AutomationId="{x:Bind CopyAutomationId}" x:Uid="ServersPage_Button42" />
                                                        <Button Click="DeleteServer_Click" AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}" x:Uid="ServersPage_Button44" />
                                                    </StackPanel>
                                                </controls:SettingsCard>
                                            </controls:SettingsExpander.Items>
                                        </controls:SettingsExpander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Uid="Groups_Section">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="Groups_AddCard">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE902;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Click="AddGroup_Click" AutomationProperties.AutomationId="Groups_Add" x:Uid="Groups_Add" />
                            </controls:SettingsCard>
                            <ListView x:Name="GroupList" SelectionMode="None" IsItemClickEnabled="False" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:GroupRow">
                                        <controls:SettingsExpander Header="{x:Bind Name}" Description="{x:Bind Description}" IsExpanded="False" AutomationProperties.AutomationId="{x:Bind ExpanderAutomationId}">
                                            <controls:SettingsExpander.HeaderIcon>
                                                <FontIcon Glyph="&#xE902;" />
                                            </controls:SettingsExpander.HeaderIcon>
                                            <controls:SettingsExpander.Content>
                                                <ComboBox MinWidth="{StaticResource SettingActionControlMinWidth}" ItemsSource="{x:Bind Members}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{x:Bind Selected}" Visibility="{x:Bind IsSelect}" SelectionChanged="GroupMember_SelectionChanged" AutomationProperties.AutomationId="{x:Bind MemberAutomationId}" x:Uid="Groups_Member" />
                                            </controls:SettingsExpander.Content>
                                            <controls:SettingsExpander.Items>
                                                <controls:SettingsCard x:Uid="Groups_ManageCard">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Click="EditGroup_Click" AutomationProperties.AutomationId="{x:Bind EditAutomationId}" x:Uid="ServersPage_Button40" />
                                                        <Button Click="DeleteGroup_Click" AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}" x:Uid="ServersPage_Button44" />
                                                    </StackPanel>
                                                </controls:SettingsCard>
                                            </controls:SettingsExpander.Items>
                                        </controls:SettingsExpander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>
            </StackPanel>
        </local:PageLayout.PageContent>
    </local:PageLayout>
</Page>
