<Page x:Class="FluentSingBox.Client.Views.ServersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:FluentSingBox.Client.Models" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:local="using:FluentSingBox.Client.Views">
    <local:PageLayout>
        <local:PageLayout.HeaderContent>
            <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" x:Uid="ServersPage_TextBlock4" />
        </local:PageLayout.HeaderContent>
        <local:PageLayout.PageContent>
            <StackPanel Spacing="0">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="ServersPage_TextBlock7" />
                <InfoBar x:Name="OperationMessage" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="Servers_Status" />

                <local:SettingsSection x:Uid="ServersPage_SettingsSection9">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="ServersPage_SettingsCard12">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="ImportServer_Click" AutomationProperties.AutomationId="Servers_Import" x:Uid="ServersPage_Button16" />
                                    <Button AutomationProperties.AutomationId="Servers_Add" Click="AddServer_Click" Style="{StaticResource AccentButtonStyle}" x:Uid="ServersPage_Button17" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Uid="ServersPage_SettingsSection18">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <TextBlock x:Name="EmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="ServersPage_EmptyMessage" />
                            <ListView x:Name="ServerList" SelectionMode="None" IsItemClickEnabled="False" Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ServerProfile">
                                        <controls:SettingsExpander Header="{x:Bind Name, Mode=OneWay}" IsExpanded="False" AutomationProperties.AutomationId="{x:Bind ExpanderAutomationId}">
                                            <controls:SettingsExpander.HeaderIcon>
                                                <FontIcon Glyph="" />
                                            </controls:SettingsExpander.HeaderIcon>
                                            <controls:SettingsExpander.Description>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{x:Bind Endpoint, Mode=OneWay}" />
                                                    <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind ProtocolSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Visibility="{x:Bind IsDefault, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="ServersPage_TextBlock33" />
                                                </StackPanel>
                                            </controls:SettingsExpander.Description>
                                            <controls:SettingsExpander.Items>
                                                <controls:SettingsCard x:Uid="ServersPage_SettingsCard35">
                                                    <Button Click="SetDefault_Click" AutomationProperties.AutomationId="{x:Bind DefaultAutomationId}" x:Uid="ServersPage_Button36" />
                                                </controls:SettingsCard>
                                                <controls:SettingsCard x:Uid="ServersPage_SettingsCard37">
                                                    <Button Click="ProbeServer_Click" AutomationProperties.AutomationId="{x:Bind ProbeAutomationId}" x:Uid="ServersPage_Button38" />
                                                </controls:SettingsCard>
                                                <controls:SettingsCard x:Uid="ServersPage_SettingsCard39">
                                                    <Button Click="EditServer_Click" AutomationProperties.AutomationId="{x:Bind EditAutomationId}" x:Uid="ServersPage_Button40" />
                                                </controls:SettingsCard>
                                                <controls:SettingsCard x:Uid="ServersPage_SettingsCard41">
                                                    <Button Click="CopyServer_Click" AutomationProperties.AutomationId="{x:Bind CopyAutomationId}" x:Uid="ServersPage_Button42" />
                                                </controls:SettingsCard>
                                                <controls:SettingsCard x:Uid="ServersPage_SettingsCard43">
                                                    <Button Click="DeleteServer_Click" AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}" x:Uid="ServersPage_Button44" />
                                                </controls:SettingsCard>
                                            </controls:SettingsExpander.Items>
                                        </controls:SettingsExpander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>
            </StackPanel>
        </local:PageLayout.PageContent>
    </local:PageLayout>
</Page>
