<UserControl
    x:Class="FluentSingBox.Client.Views.PageLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentPresenter
            x:Name="HeaderPresenter"
            MaxWidth="{StaticResource PageHeaderMaxWidth}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Content="{x:Bind HeaderContent, Mode=OneWay}" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            AutomationProperties.AutomationId="PageScrollViewer">
            <Grid Padding="0,0,20,48">
                <ContentPresenter
                    x:Name="PageContentPresenter"
                    MaxWidth="{StaticResource PageMaxWidth}"
                    HorizontalAlignment="Stretch"
                    Content="{x:Bind PageContent, Mode=OneWay}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
