<Page
    x:Class="FluentSingBox.Client.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:FluentSingBox.Client.Views">
    <local:PageLayout>
        <local:PageLayout.HeaderContent>
            <TextBlock
                Text="设置"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Style="{StaticResource TitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level1" />
        </local:PageLayout.HeaderContent>
        <local:PageLayout.PageContent>
            <StackPanel Spacing="0">
                <TextBlock Text="应用启动、外观和维护选项。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <local:SettingsSection Header="外观">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard Header="主题" Description="默认读取 Windows 的浅色或深色设置。">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE790;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="ThemeComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedValuePath="Tag" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="跟随系统" Tag="system" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection Header="启动">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard Header="开机启动" Description="登录 Windows 后自动启动 fluent sing-box。">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xF71C;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="StartupSwitch" MinWidth="{StaticResource SettingActionControlMinWidth}" Toggled="StartupSwitch_Toggled" AutomationProperties.Name="开机启动" />
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection Header="sing-box 核心">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard Header="核心程序">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE756;" />
                                </controls:SettingsCard.HeaderIcon>
                                <controls:SettingsCard.Description>
                                    <TextBlock x:Name="SingBoxPathDescription" Text="尚未选择 sing-box.exe。" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                                </controls:SettingsCard.Description>
                                <Button x:Name="SingBoxCorePathButton" Content="选择其他核心" Click="SingBoxCorePath_Click" />
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection Header="更新与反馈">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard Header="检查更新" Description="当前为开发预览版；配置发布源后可检查并安装更新。">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE895;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Content="检查更新" Click="CheckForUpdates_Click" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="反馈" Description="填写反馈并复制内容，方便粘贴到问题单或邮件中。">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xED15;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Content="提交反馈" Click="Feedback_Click" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="sing-box 文档" Description="查看 sing-box 的协议和配置说明。" IsClickEnabled="True" ActionIconToolTip="在浏览器中打开" Click="OpenSingBoxDocs_Click">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </controls:SettingsCard.HeaderIcon>
                                <controls:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </controls:SettingsCard.ActionIcon>
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <TextBlock Margin="1,32,0,0" Text="fluent sing-box · 0.1.0 开发预览" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </local:PageLayout.PageContent>
    </local:PageLayout>
</Page>
