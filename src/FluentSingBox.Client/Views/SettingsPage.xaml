<Page x:Class="FluentSingBox.Client.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:local="using:FluentSingBox.Client.Views">
    <local:PageLayout>
        <local:PageLayout.HeaderContent>
            <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" x:Uid="SettingsPage_TextBlock4" />
        </local:PageLayout.HeaderContent>
        <local:PageLayout.PageContent>
            <StackPanel Spacing="0">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Uid="SettingsPage_TextBlock7" />

                <local:SettingsSection x:Uid="SettingsPage_SettingsSection8">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="SettingsPage_SettingsCard11">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="ThemeComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedValuePath="Tag" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Right">
                                    <ComboBoxItem Tag="system" x:Uid="SettingsPage_ComboBoxItem15" />
                                    <ComboBoxItem Tag="light" x:Uid="SettingsPage_ComboBoxItem16" />
                                    <ComboBoxItem Tag="dark" x:Uid="SettingsPage_ComboBoxItem17" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="Settings_Language">
                                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;" /></controls:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="LanguageComboBox" MinWidth="{StaticResource SettingActionControlMinWidth}" SelectedValuePath="Tag" SelectionChanged="LanguageComboBox_SelectionChanged" AutomationProperties.AutomationId="Settings_Language">
                                    <ComboBoxItem Tag="system" x:Uid="Settings_Language_System" AutomationProperties.AutomationId="Settings_Language_system" />
                                    <ComboBoxItem Tag="zh-CN" x:Uid="Settings_Language_Chinese" AutomationProperties.AutomationId="Settings_Language_zh-CN" />
                                    <ComboBoxItem Tag="en-US" x:Uid="Settings_Language_English" AutomationProperties.AutomationId="Settings_Language_en-US" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <InfoBar x:Name="LanguageStatus" IsClosable="True" Severity="Informational" AutomationProperties.AutomationId="Settings_LanguageStatus" />
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Uid="SettingsPage_SettingsSection18">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="SettingsPage_SettingsCard21">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="StartupSwitch" MinWidth="{StaticResource SettingActionControlMinWidth}" Toggled="StartupSwitch_Toggled" x:Uid="SettingsPage_StartupSwitch" />
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Uid="SettingsPage_SettingsSection25">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="SettingsPage_SettingsCard28">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="" />
                                </controls:SettingsCard.HeaderIcon>
                                <controls:SettingsCard.Description>
                                    <TextBlock x:Name="SingBoxPathDescription" TextWrapping="Wrap" HorizontalAlignment="Left" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="Settings_CoreDescription" x:Uid="SettingsPage_SingBoxPathDescription" />
                                </controls:SettingsCard.Description>
                                <Button x:Name="SingBoxCorePathButton" Click="SingBoxCorePath_Click" x:Uid="SettingsPage_SingBoxCorePathButton" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPage_SettingsCard37" />
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Name="ConfigurationSection">
                    <local:SettingsSection.SectionContent>
                        <local:ConfigurationSettingsControl />
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <local:SettingsSection x:Uid="SettingsPage_SettingsSection38">
                    <local:SettingsSection.SectionContent>
                        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                            <controls:SettingsCard x:Uid="SettingsPage_SettingsCard41">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Click="CheckForUpdates_Click" x:Uid="SettingsPage_Button44" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingsPage_SettingsCard45">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Click="Feedback_Click" x:Uid="SettingsPage_Button48" />
                            </controls:SettingsCard>
                            <controls:SettingsCard IsClickEnabled="True" Click="OpenSingBoxDocs_Click" x:Uid="SettingsPage_SettingsCard49">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="" />
                                </controls:SettingsCard.HeaderIcon>
                                <controls:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="" />
                                </controls:SettingsCard.ActionIcon>
                            </controls:SettingsCard>
                        </StackPanel>
                    </local:SettingsSection.SectionContent>
                </local:SettingsSection>

                <TextBlock Margin="1,32,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" x:Uid="SettingsPage_TextBlock54" />
            </StackPanel>
        </local:PageLayout.PageContent>
    </local:PageLayout>
</Page>
